{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vital-relay.local/contracts/v1/persona-session-rotation-receipt.schema.json",
  "title": "PersonaSessionRotationReceipt v1",
  "description": "The new short-lived access credential; the existing refresh secret remains unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "access_token",
    "rotated_at",
    "access_expires_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "session_id": { "type": "string", "format": "uuid" },
    "access_token": {
      "type": "string",
      "minLength": 43,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "rotated_at": { "type": "string", "format": "date-time" },
    "access_expires_at": { "type": "string", "format": "date-time" }
  }
}
