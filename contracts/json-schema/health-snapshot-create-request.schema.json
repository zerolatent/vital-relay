{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vital-relay.local/contracts/v1/health-snapshot-create-request.schema.json",
  "title": "HealthSnapshotCreateRequest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "user_id", "capture_reason"],
  "properties": {
    "schema_version": { "const": 1 },
    "snapshot_id": { "type": "string", "format": "uuid" },
    "user_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "capture_reason": {
      "enum": ["monitoring_started", "incident_created", "manual_refresh"]
    }
  }
}
