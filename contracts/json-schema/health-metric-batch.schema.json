{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vital-relay.local/contracts/v1/health-metric-batch.schema.json",
  "title": "HealthMetricBatch v1",
  "description": "An idempotent, single-user, single-device batch of scalar observations.",
  "$comment": "Application validation also requires unique metric_id values and each metric user_id to equal the envelope user_id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "user_id",
    "device_id",
    "sent_at",
    "metrics"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "batch_id": { "type": "string", "format": "uuid" },
    "user_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "sent_at": { "type": "string", "format": "date-time" },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "https://vital-relay.local/contracts/v1/health-metric.schema.json"
      }
    }
  }
}
