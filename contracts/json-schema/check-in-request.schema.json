{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vital-relay.local/contracts/v1/check-in-request.schema.json",
  "title": "CheckInRequest v1",
  "description": "An idempotent first-party response to an active fall verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "response_id",
    "response",
    "device_id",
    "responded_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "response_id": { "type": "string", "format": "uuid" },
    "response": { "enum": ["i_am_okay", "i_need_help"] },
    "device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "responded_at": { "type": "string", "format": "date-time" }
  }
}
