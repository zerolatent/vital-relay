{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vital-relay.local/contracts/v1/active-incident-list.schema.json",
  "title": "ActiveIncidentList v1",
  "description": "The current persona's deterministically ordered active-incident locators.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "persona", "incidents", "server_received_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "persona": { "enum": ["community", "responder", "command"] },
    "incidents": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "https://vital-relay.local/contracts/v1/active-incident-summary.schema.json"
      }
    },
    "server_received_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "persona": { "const": "responder" } },
        "required": ["persona"]
      },
      "then": {
        "properties": {
          "incidents": {
            "items": {
              "allOf": [
                {
                  "$ref": "https://vital-relay.local/contracts/v1/active-incident-summary.schema.json"
                },
                {
                  "properties": {
                    "invitation_id": { "type": "string", "format": "uuid" },
                    "invitation_status": { "enum": ["pending", "accepted"] }
                  }
                }
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "incidents": {
            "items": {
              "allOf": [
                {
                  "$ref": "https://vital-relay.local/contracts/v1/active-incident-summary.schema.json"
                },
                {
                  "properties": {
                    "invitation_id": { "type": "null" },
                    "invitation_status": { "type": "null" }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ]
}
