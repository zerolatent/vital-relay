{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vital-relay.local/contracts/v1/first-aid-protocol-source.schema.json",
  "additionalProperties": false,
  "description": "One authoritative public source used to review fixed protocol wording.",
  "properties": {
    "organization": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Organization",
      "type": "string"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "url": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Url",
      "type": "string"
    }
  },
  "required": [
    "organization",
    "title",
    "url"
  ],
  "title": "FirstAidProtocolSource",
  "type": "object"
}
